@model BookListViewModel
@{
    ViewData["Title"] = "Kitaplar";
    ViewData["PageSubtitle"] = "Katalogdaki eserler ve müsait kopyalar";
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-header-actions">
        <a class="btn btn-primary" asp-action="Create">Yeni kitap</a>
    </div>
</div>

<form method="get" class="filter-bar row g-2 align-items-end">
    <div class="col-md-5">
        <label class="form-label">Ara</label>
        <input class="form-control" name="term" value="@Model.Term" placeholder="Ad, yazar veya ISBN" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Kategori</label>
        <select class="form-select" name="categoryId" asp-items="ViewBag.Categories"></select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-secondary w-100">Filtrele</button>
    </div>
</form>

@if (Model.Result.TotalCount == 0)
{
    <div class="empty-state">Kayıt bulunamadı. Farklı bir arama deneyin veya yeni kitap ekleyin.</div>
}
else
{
    <div class="book-grid mb-4">
        @foreach (var book in Model.Result.Items)
        {
            var available = book.GetAvailableCopyCount();
            var total = book.Copies.Count(c => !c.IsDeleted);
            var authors = string.Join(", ", book.BookAuthors.Select(ba => ba.Author.FullName));
            <article class="book-card">
                <a asp-action="Details" asp-route-id="@book.Id" class="text-decoration-none text-dark d-flex flex-column h-100">
                    <partial name="_BookCover" model="new BookCoverViewModel { Url = book.CoverImageUrl, Title = book.Title }" />
                    <div class="book-card-body">
                        <h2 class="book-card-title">@book.Title</h2>
                        <p class="book-card-meta">@authors</p>
                        <div class="book-card-footer">
                            <span class="badge text-bg-@(available > 0 ? "success" : "secondary")">@available / @total</span>
                            <span class="small text-muted">@book.Category?.Name</span>
                        </div>
                    </div>
                </a>
            </article>
        }
    </div>

    @if (Model.Result.TotalPages > 1)
    {
        <nav aria-label="Sayfalar">
            <ul class="pagination">
                @for (var p = 1; p <= Model.Result.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Result.Page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@p"
                           asp-route-term="@Model.Term"
                           asp-route-categoryId="@Model.CategoryId">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
