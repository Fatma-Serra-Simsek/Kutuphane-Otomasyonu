@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string NavClass(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase))
            ? "active"
            : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kütüphane Yönetim Sistemi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,500;7..72,600;7..72,700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="_Toast" />
    <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">K</span>
                <span class="brand-title">Kütüphane</span>
                <span class="brand-sub">Yönetim Sistemi</span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <ul class="app-nav">
                    <li class="nav-section">Genel</li>
                    <li>
                        <a class="@NavClass("Home", "Index")" asp-controller="Home" asp-action="Index">Ana panel</a>
                    </li>
                    <li class="nav-section">Katalog</li>
                    <li>
                        <a class="@NavClass("Books")" asp-controller="Books" asp-action="Index">Kitaplar</a>
                    </li>
                    <li>
                        <a class="@NavClass("Members")" asp-controller="Members" asp-action="Index">Üyeler</a>
                    </li>
                    <li class="nav-section">İşlemler</li>
                    <li>
                        <a class="@NavClass("Loans", "Borrow")" asp-controller="Loans" asp-action="Borrow">Ödünç ver</a>
                    </li>
                    <li>
                        <a class="@NavClass("Loans", "Return")" asp-controller="Loans" asp-action="Return">İade al</a>
                    </li>
                    <li>
                        <a class="@NavClass("Loans", "Active")" asp-controller="Loans" asp-action="Active">Ödünçtekiler</a>
                    </li>
                    <li>
                        <a class="@NavClass("Loans", "Overdue")" asp-controller="Loans" asp-action="Overdue">Gecikmişler</a>
                    </li>
                    <li class="nav-section">Yönetim</li>
                    <li>
                        <a class="@NavClass("Reports")" asp-controller="Reports" asp-action="Index">Raporlar</a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li>
                            <a class="@NavClass("Settings")" asp-controller="Settings" asp-action="Index">Ayarlar</a>
                        </li>
                    }
                </ul>
            }
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Menüyü aç">Menü</button>
                    <span class="text-muted d-none d-md-inline">@ViewData["Title"]</span>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-3">
                        <span class="user-chip">@User.Identity?.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Çıkış</button>
                        </form>
                    </div>
                }
            </header>
            <main class="app-content">
                @RenderBody()
            </main>
            <footer class="app-footer">
                &copy; @DateTime.Now.Year Kütüphane Yönetim Sistemi
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
