@model ReportDateRangeViewModel
@{
    ViewData["Title"] = "Tarih aralığı ödünçleri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tarih aralığına göre ödünçler</h1>
    @if (Model.Results is not null)
    {
        <a class="btn btn-outline-success"
           asp-action="ExportByDateRange"
           asp-route-from="@Model.From.ToString("yyyy-MM-dd")"
           asp-route-to="@Model.To.ToString("yyyy-MM-dd")">CSV indir</a>
    }
</div>
<p><a asp-action="Index">Raporlara dön</a></p>

<form method="post" class="row g-2 mb-4">
    @Html.AntiForgeryToken()
    <div class="col-md-3">
        <label asp-for="From" class="form-label"></label>
        <input asp-for="From" class="form-control" type="date" />
    </div>
    <div class="col-md-3">
        <label asp-for="To" class="form-label"></label>
        <input asp-for="To" class="form-control" type="date" />
    </div>
    <div class="col-md-3 align-self-end">
        <button type="submit" class="btn btn-primary">Görüntüle</button>
    </div>
</form>

@if (Model.Results is not null)
{
    if (Model.Results.Count == 0)
    {
        <p class="text-muted">Seçilen aralıkta kayıt yok.</p>
    }
    else
    {
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Üye</th>
                    <th>Kitap</th>
                    <th>Barkod</th>
                    <th>Teslim</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var loan in Model.Results)
            {
                <tr>
                    <td>@loan.LoanDate.ToString("dd.MM.yyyy")</td>
                    <td>@loan.MemberName</td>
                    <td>@loan.BookTitle</td>
                    <td>@loan.Barcode</td>
                    <td>@loan.DueDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        @if (loan.ReturnDate is not null)
                        {
                            <span class="badge text-bg-secondary">İade</span>
                        }
                        else if (loan.IsOverdue)
                        {
                            <span class="badge text-bg-danger">Gecikmiş</span>
                        }
                        else
                        {
                            <span class="badge text-bg-primary">Ödünçte</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
}
