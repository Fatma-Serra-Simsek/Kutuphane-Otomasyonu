@model IReadOnlyList<Library.Domain.Entities.Loan>
@{
    ViewData["Title"] = "Ödünçtekiler";
    ViewData["PageSubtitle"] = "Aktif ödünç kayıtları";
}

<div class="page-header">
    <partial name="_PageHeader" />
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">Aktif ödünç yok.</div>
}
else
{
    <div class="table-panel">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Üye</th>
                        <th>Kitap</th>
                        <th>Barkod</th>
                        <th>Ödünç</th>
                        <th>Teslim</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var loan in Model)
                {
                    <tr>
                        <td>@loan.Member?.FullName</td>
                        <td>@loan.BookCopy?.Book?.Title</td>
                        <td>@loan.BookCopy?.Barcode</td>
                        <td>@loan.LoanDate.ToString("dd.MM.yyyy")</td>
                        <td>@loan.DueDate.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (loan.IsOverdue())
                            {
                                <span class="badge text-bg-danger">Gecikmiş</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
