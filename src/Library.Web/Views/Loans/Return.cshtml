@model ReturnViewModel
@{
    ViewData["Title"] = "İade al";
    ViewData["PageSubtitle"] = "Barkod ile iade işlemi";
}

<div class="page-header">
    <partial name="_PageHeader" />
</div>

<div class="form-panel">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Barcode" class="form-label"></label>
            <input asp-for="Barcode" class="form-control" autofocus autocomplete="off" />
            <span asp-validation-for="Barcode" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">İade al</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
