@model ReturnViewModel
@{
    ViewData["Title"] = "İade al";
}

<h1 class="h3 mb-3">İade al</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Barcode" class="form-label"></label>
        <input asp-for="Barcode" class="form-control" autofocus autocomplete="off" />
        <span asp-validation-for="Barcode" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">İade al</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
